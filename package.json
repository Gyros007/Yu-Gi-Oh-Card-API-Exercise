{
  "name": "yu-gi-oh-card-api-exercise",
  "author": "Andreas Thoma",
  "version": "1.0.0",
  "description": "A small REST API using Node.js and MongoDB to manage a collection of Yu-Gi-Oh! cards. The goal is to demonstrate backend engineering practices, code organization, and developer ergonomics.",
  "homepage": "https://github.com/Gyros007/Yu-Gi-Oh-Card-API-Exercise#readme",
  "bugs": {
    "url": "https://github.com/Gyros007/Yu-Gi-Oh-Card-API-Exercise/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gyros007/Yu-Gi-Oh-Card-API-Exercise.git"
  },
  "scripts": {
    "build": "npx tsc",
    "serve": "node build/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.2"
  }
}
